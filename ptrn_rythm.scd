==============================================
Можно запустить Prand, а внутри него - Pbindef

(
~rand_form = Pxrand([
	Pbind(
		\freq, Pser((1..4) * 220, 10),
		\dur, 0.25
	),
	Pbind(
		\freq, Pseq(((1..4).reverse) * 110, 2),
		\dur, 1.33
	),
	Pbind(
		\freq, Prand([1, 1/3, 2/5, 3, 5/3, 17/3, 22/7] * 330, 5),
		\dur, 2
	),
], 10).play;
)

~rand_form.stop;

