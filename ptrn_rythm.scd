~clck1 = TempoClock(120/100);

~clck1.beats;

(
Pbindef(\seq1).clear;
Pbindef(
	\seq1,
	\instrument, \hihat1,
	\dur, 1,
).play(argClock: ~clck1, quant: 4);
)

(
Pbindef(
	\seq1,
	\dur,
	Pser([
		1, 1, 1, 1,
		1, 1, 1, Rest(1)
	], inf) * 0.25
);
)
Pbindef(\seq1).stop;


(
Pbindef(\seq_cymbal).clear;
Pbindef(
	\seq_cymbal,
	\instrument, \cymbal808,
	\dur,
	Pser([
		Rest(1), Rest(1), Rest(1), Rest(1),
		Rest(1), Rest(1), Rest(1), 1
	], inf) * 0.25
).play(argClock: ~clck1, quant: 4);
)
Pbindef(\seq_cymbal).stop;


(
Pbindef(\seq_kick).clear;
Pbindef(
	\seq_kick,
	\instrument, \kick1,
	\dur,
	Pser([
		1, Rest(1), 1, Rest(1),
		1, Rest(1), 1, 1
	], inf) * 0.25,
).play(argClock: ~clck1, quant: 4);
)
Pbindef(\seq_kick).stop;


/*
В Pser на место литералов можно ставить конечные паттерны

Начнем с

Pser([
		1, Rest(1), 1, Rest(1),
		1, Rest(1), 1, 1
	], inf)
*/


(
Pbindef(\seq_snare).clear;
Pbindef(
	\seq_snare,
	\instrument, \snare1,
	\dur, Pser([
		Rest(1), 1, Rest(1), Prand([Rest(1), Rest(1), 1]),
		Rest(1),
		Prand([
			Rest(1),
			Pseq([Rest(0.5), 0.5]),
			Pseq([Rest(0.25), 0.25, Rest(0.5)]),
			// Pseq([Rest(0.25), 0.25/2, Rest(0.25/2), 0.5]),
			Pseq([Rest(1), 1, 1])/3,
			Pseq([Rest(1), 1, Rest(1), 1, Rest(1)])/5,
		]),
		Rest(1),
		1
	], inf) * 0.25,
).play(argClock: ~clck1, quant: 4);
)
Pbindef(\seq_snare).stop;

