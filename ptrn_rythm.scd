			[
				// Pn(1, 5),
				1, 1, 1, 1, 1,
				2,
				3
			],
			inf
		)
	).linlin(1, 15, 1, 5),
).play(argClock: ~clck1, quant: 4);
)
Pbindef(\kick_drift_seq1).stop;


